# Copy this file to .env and fill in real values for local dev.
# On Vercel, set the same variable under Project Settings → Environment Variables.
# .env is git-ignored — never commit real values.

# "Continue with Google" sign-in — same Client ID as server/.env's GOOGLE_CLIENT_ID.
# Public value, safe to expose client-side. Get it from
# https://console.cloud.google.com → APIs & Services → Credentials.
# Leave blank to keep the Google button off the login page.
VITE_GOOGLE_CLIENT_ID=
