# Copy this file to .env and fill in real values before running the server.
# .env is git-ignored — never commit real secrets.

# Used to sign/verify login tokens. Use a long, random string in production.
# Generate one quickly with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000

# Password reset emails (https://resend.com — free tier available)
RESEND_API_KEY=
EMAIL_FROM=Nuvora <no-reply@yourdomain.com>

# Used to build the password reset link sent in emails.
# Local dev: http://localhost:5173   |  Production: your Vercel URL
APP_URL=http://localhost:5173

# "Continue with Google" sign-in. Get this from https://console.cloud.google.com
# → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Same value goes in client/.env as VITE_GOOGLE_CLIENT_ID (it's public, safe to
# expose client-side — it's an ID, not a secret). Leave blank to keep the
# Google button off until this is set up.
GOOGLE_CLIENT_ID=